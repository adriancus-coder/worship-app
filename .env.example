# Copy to .env for local development. Never commit a real .env.

APP_NAME=Worship App
PORT=3000
NODE_ENV=development

# Where the SQLite database lives (created if missing).
DATA_DIR=./data

# Required to run first-run setup at /setup. Leave empty to disable setup.
SETUP_TOKEN=

# Optional: public URL of the app, without trailing slash.
PUBLIC_BASE_URL=

# Optional: debug | info | warn | error
LOG_LEVEL=info

# Video uploads (media library), in MB: per file and per church.
MEDIA_MAX_FILE_MB=150
MEDIA_MAX_ADMIN_MB=500

# Uploads are refused when the disk would have less than this % free (0 = no check).
DISK_MIN_FREE_PCT=15

# Optional: outgoing email (invitations, password resets) through Resend — docs/EMAIL.md.
# Email is off unless both are set.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
